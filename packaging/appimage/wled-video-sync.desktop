[Desktop Entry]
Type=Application
Name=WLED Web Video Sync
Comment=Sync screen capture and video to WLED matrices (DDP, Art-Net, sACN)
Exec=wled-video-sync
Icon=wled-video-sync
# Terminal=false: the app starts silently and is stopped from the "Quit App"
# button in the UI. Desktop environments surface `Terminal=true` as a
# "This app runs in the terminal" notice, which is not wanted here.
Terminal=false
Categories=Graphics;
Keywords=WLED;LED;DMX;Art-Net;sACN;DDP;Pixel;
